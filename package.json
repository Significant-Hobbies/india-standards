{
  "name": "india-standards",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "db:seed": "node scripts/seed-demo-db.mjs",
    "data:stage:plfs": "node scripts/import-plfs-2025.mjs",
    "data:verify:motherduck": "node scripts/verify-motherduck.mjs",
    "build:cf": "opennextjs-cloudflare build",
    "preview:cf": "pnpm build:cf && opennextjs-cloudflare preview",
    "deploy:cf": "pnpm build:cf && opennextjs-cloudflare deploy --tag \"$(git rev-parse HEAD)\"",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv ./cloudflare-env.d.ts",
    "cf:types:check": "wrangler types --env-interface CloudflareEnv ./cloudflare-env.d.ts --check",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts tests/*.test.mjs",
    "check": "pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "@duckdb/node-api": "1.5.5-r.1",
    "next": "16.2.12",
    "pg": "8.22.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.20.2",
    "@types/node": "^24.0.0",
    "@types/pg": "8.20.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.9.0",
    "wrangler": "4.114.0"
  },
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "overrides": {
      "@node-minify/core@8.0.6>glob": "12.0.0",
      "postcss@<=8.5.17": "8.5.23",
      "sharp@<0.35.0": "0.35.3"
    }
  },
  "packageManager": "pnpm@10.33.2"
}
